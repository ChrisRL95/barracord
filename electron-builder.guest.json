{
  "appId": "fun.chrisrl.barracord",
  "productName": "Barracord",
  "artifactName": "Barracord-Setup-${version}.${ext}",
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "electron/role.guest.json",
      "to": "barracord-role.json"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "extraResources": [
      {
        "from": "tools/app-audio/barracord-app-audio.exe",
        "to": "tools/app-audio/barracord-app-audio.exe"
      },
      {
        "from": "tools/tailscale",
        "to": "tools/tailscale"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ChrisRL95",
      "repo": "barracord",
      "channel": "beta",
      "releaseType": "prerelease"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "linux": {
    "target": [
      "AppImage",
      "rpm"
    ],
    "category": "Network;Chat",
    "executableName": "barracord",
    "artifactName": "Barracord-${version}-${arch}.${ext}",
    "synopsis": "Voz, chat e compartilhamento de tela da Barraca",
    "maintainer": "Chris",
    "syncDesktopName": true
  },
  "rpm": {
    "depends": [
      "tailscale"
    ]
  }
}
