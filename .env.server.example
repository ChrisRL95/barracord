# Nunca coloque estas chaves no app web; elas ficam apenas no PC que hospeda o servidor.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Código compartilhado apenas com amigos convidados.
APP_INVITE_CODE=troque-por-um-codigo-de-convite
WEB_ORIGIN=http://localhost:5173
TOKEN_SERVER_PORT=3001
# Credenciais do OAuth Client do Tailscale. Nunca coloque estes valores no cliente dos amigos.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_GUEST_TAG=tag:barracord-guest
